{
  "manifest_version": 3,
  "name": "일어나! 기지개 알림",
  "version": "1.0.0",
  "description": "50분마다 귀여운 기지개 알림으로 오래 앉아 있는 시간을 줄여요.",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "일어나! 기지개 알림",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
